  75:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** // The application name to be displayed in SystemViewer
  76:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** #define SYSVIEW_APP_NAME        "FreeRTOS HAL_UART_SystemView"
  77:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** 
  78:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** // The target device name
  79:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** #define SYSVIEW_DEVICE_NAME     "Cortex-M4"
  80:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** 
  81:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** // Frequency of the timestamp. Must match SEGGER_SYSVIEW_GET_TIMESTAMP in SEGGER_SYSVIEW_Conf.h
  82:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** #define SYSVIEW_TIMESTAMP_FREQ  (configCPU_CLOCK_HZ)
  83:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** 
  84:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** // System Frequency. SystemcoreClock is used in most CMSIS compatible projects.
  85:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** #define SYSVIEW_CPU_FREQ        configCPU_CLOCK_HZ
  86:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** 
  87:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** // The lowest RAM address used for IDs (pointers)
  88:Core/SystemView/SEGGER_SYSVIEW_Config_FreeRTOS.c **** #define SYSVIEW_RAM_BASE        (0x20000000)
