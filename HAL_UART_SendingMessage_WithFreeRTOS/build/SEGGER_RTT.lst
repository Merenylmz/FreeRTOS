 316:Core/SystemView/SEGGER_RTT.c **** /*********************************************************************
 317:Core/SystemView/SEGGER_RTT.c **** *
 318:Core/SystemView/SEGGER_RTT.c **** *       _WriteBlocking()
 319:Core/SystemView/SEGGER_RTT.c **** *
 320:Core/SystemView/SEGGER_RTT.c **** *  Function description
 321:Core/SystemView/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT ring buffer
 322:Core/SystemView/SEGGER_RTT.c **** *    and updates the associated write pointer which is periodically
 323:Core/SystemView/SEGGER_RTT.c **** *    read by the host.
 324:Core/SystemView/SEGGER_RTT.c **** *    The caller is responsible for managing the write chunk sizes as
 325:Core/SystemView/SEGGER_RTT.c **** *    _WriteBlocking() will block until all data has been posted successfully.
 326:Core/SystemView/SEGGER_RTT.c **** *
 327:Core/SystemView/SEGGER_RTT.c **** *  Parameters
 328:Core/SystemView/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 329:Core/SystemView/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 330:Core/SystemView/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
 331:Core/SystemView/SEGGER_RTT.c **** *
 332:Core/SystemView/SEGGER_RTT.c **** *  Return value
 333:Core/SystemView/SEGGER_RTT.c **** *    >= 0 - Number of bytes written into buffer.
 334:Core/SystemView/SEGGER_RTT.c **** */
 335:Core/SystemView/SEGGER_RTT.c **** static unsigned _WriteBlocking(SEGGER_RTT_BUFFER_UP* pRing, const char* pBuffer, unsigned NumBytes)
 336:Core/SystemView/SEGGER_RTT.c ****   unsigned NumBytesToWrite;
 337:Core/SystemView/SEGGER_RTT.c ****   unsigned NumBytesWritten;
 338:Core/SystemView/SEGGER_RTT.c ****   unsigned RdOff;
 339:Core/SystemView/SEGGER_RTT.c ****   unsigned WrOff;
 340:Core/SystemView/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 341:Core/SystemView/SEGGER_RTT.c ****   char*    pDst;
 342:Core/SystemView/SEGGER_RTT.c **** #endif
 343:Core/SystemView/SEGGER_RTT.c ****   //
 344:Core/SystemView/SEGGER_RTT.c ****   // Write data to buffer and handle wrap-around if necessary
 345:Core/SystemView/SEGGER_RTT.c ****   //
 346:Core/SystemView/SEGGER_RTT.c ****   NumBytesWritten = 0u;
 347:Core/SystemView/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 348:Core/SystemView/SEGGER_RTT.c ****   do {
 349:Core/SystemView/SEGGER_RTT.c ****     RdOff = pRing->RdOff;                         // May be changed by host (debug probe) in the me
 350:Core/SystemView/SEGGER_RTT.c ****     if (RdOff > WrOff) {
 351:Core/SystemView/SEGGER_RTT.c ****       NumBytesToWrite = RdOff - WrOff - 1u;
 352:Core/SystemView/SEGGER_RTT.c ****     } else {
 353:Core/SystemView/SEGGER_RTT.c ****       NumBytesToWrite = pRing->SizeOfBuffer - (WrOff - RdOff + 1u);
 354:Core/SystemView/SEGGER_RTT.c ****     }
 355:Core/SystemView/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, (pRing->SizeOfBuffer - WrOff));      // Number of bytes 
 356:Core/SystemView/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, NumBytes);
 357:Core/SystemView/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 358:Core/SystemView/SEGGER_RTT.c ****     pDst = pRing->pBuffer + WrOff;
 359:Core/SystemView/SEGGER_RTT.c ****     NumBytesWritten += NumBytesToWrite;
 360:Core/SystemView/SEGGER_RTT.c ****     NumBytes        -= NumBytesToWrite;
 361:Core/SystemView/SEGGER_RTT.c ****     WrOff           += NumBytesToWrite;
 362:Core/SystemView/SEGGER_RTT.c ****     while (NumBytesToWrite--) {
 363:Core/SystemView/SEGGER_RTT.c ****       *pDst++ = *pBuffer++;
 364:Core/SystemView/SEGGER_RTT.c ****     };
 365:Core/SystemView/SEGGER_RTT.c **** #else
 366:Core/SystemView/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY(pRing->pBuffer + WrOff, pBuffer, NumBytesToWrite);
 367:Core/SystemView/SEGGER_RTT.c ****     NumBytesWritten += NumBytesToWrite;
 368:Core/SystemView/SEGGER_RTT.c ****     pBuffer         += NumBytesToWrite;
 369:Core/SystemView/SEGGER_RTT.c ****     NumBytes        -= NumBytesToWrite;
 370:Core/SystemView/SEGGER_RTT.c ****     WrOff           += NumBytesToWrite;
 371:Core/SystemView/SEGGER_RTT.c **** #endif
 372:Core/SystemView/SEGGER_RTT.c ****     if (WrOff == pRing->SizeOfBuffer) {
ARM GAS  /tmp/cc83jmLU.s 			page 8


 373:Core/SystemView/SEGGER_RTT.c ****       WrOff = 0u;
 374:Core/SystemView/SEGGER_RTT.c ****     }
 375:Core/SystemView/SEGGER_RTT.c ****     pRing->WrOff = WrOff;
 376:Core/SystemView/SEGGER_RTT.c ****   } while (NumBytes);
 377:Core/SystemView/SEGGER_RTT.c ****   //
 378:Core/SystemView/SEGGER_RTT.c ****   return NumBytesWritten;
 379:Core/SystemView/SEGGER_RTT.c **** }
