 381:Core/SystemView/SEGGER_RTT.c **** /*********************************************************************
 382:Core/SystemView/SEGGER_RTT.c **** *
 383:Core/SystemView/SEGGER_RTT.c **** *       _WriteNoCheck()
 384:Core/SystemView/SEGGER_RTT.c **** *
 385:Core/SystemView/SEGGER_RTT.c **** *  Function description
 386:Core/SystemView/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT ring buffer
 387:Core/SystemView/SEGGER_RTT.c **** *    and updates the associated write pointer which is periodically
 388:Core/SystemView/SEGGER_RTT.c **** *    read by the host.
 389:Core/SystemView/SEGGER_RTT.c **** *    It is callers responsibility to make sure data actually fits in buffer.
 390:Core/SystemView/SEGGER_RTT.c **** *
 391:Core/SystemView/SEGGER_RTT.c **** *  Parameters
 392:Core/SystemView/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 393:Core/SystemView/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 394:Core/SystemView/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
 395:Core/SystemView/SEGGER_RTT.c **** *
 396:Core/SystemView/SEGGER_RTT.c **** *  Notes
 397:Core/SystemView/SEGGER_RTT.c **** *    (1) If there might not be enough space in the "Up"-buffer, call _WriteBlocking
 398:Core/SystemView/SEGGER_RTT.c **** */
 399:Core/SystemView/SEGGER_RTT.c **** static void _WriteNoCheck(SEGGER_RTT_BUFFER_UP* pRing, const char* pData, unsigned NumBytes) {
 400:Core/SystemView/SEGGER_RTT.c ****   unsigned NumBytesAtOnce;
 401:Core/SystemView/SEGGER_RTT.c ****   unsigned WrOff;
 402:Core/SystemView/SEGGER_RTT.c ****   unsigned Rem;
 403:Core/SystemView/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 404:Core/SystemView/SEGGER_RTT.c ****   char*    pDst;
 405:Core/SystemView/SEGGER_RTT.c **** #endif
 406:Core/SystemView/SEGGER_RTT.c **** 
 407:Core/SystemView/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 408:Core/SystemView/SEGGER_RTT.c ****   Rem = pRing->SizeOfBuffer - WrOff;
 409:Core/SystemView/SEGGER_RTT.c ****   if (Rem > NumBytes) {
 410:Core/SystemView/SEGGER_RTT.c ****     //
 411:Core/SystemView/SEGGER_RTT.c ****     // All data fits before wrap around
 412:Core/SystemView/SEGGER_RTT.c ****     //
 413:Core/SystemView/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 414:Core/SystemView/SEGGER_RTT.c ****     pDst = pRing->pBuffer + WrOff;
 415:Core/SystemView/SEGGER_RTT.c ****     WrOff += NumBytes;
 416:Core/SystemView/SEGGER_RTT.c ****     while (NumBytes--) {
 417:Core/SystemView/SEGGER_RTT.c ****       *pDst++ = *pData++;
 418:Core/SystemView/SEGGER_RTT.c ****     };
 419:Core/SystemView/SEGGER_RTT.c ****     pRing->WrOff = WrOff;
 420:Core/SystemView/SEGGER_RTT.c **** #else
 421:Core/SystemView/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY(pRing->pBuffer + WrOff, pData, NumBytes);
 422:Core/SystemView/SEGGER_RTT.c ****     pRing->WrOff = WrOff + NumBytes;
 423:Core/SystemView/SEGGER_RTT.c **** #endif
 424:Core/SystemView/SEGGER_RTT.c ****   } else {
 425:Core/SystemView/SEGGER_RTT.c ****     //
 426:Core/SystemView/SEGGER_RTT.c ****     // We reach the end of the buffer, so need to wrap around
 427:Core/SystemView/SEGGER_RTT.c ****     //
 428:Core/SystemView/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 429:Core/SystemView/SEGGER_RTT.c ****     pDst = pRing->pBuffer + WrOff;
ARM GAS  /tmp/cc83jmLU.s 			page 9


 430:Core/SystemView/SEGGER_RTT.c ****     NumBytesAtOnce = Rem;
 431:Core/SystemView/SEGGER_RTT.c ****     while (NumBytesAtOnce--) {
 432:Core/SystemView/SEGGER_RTT.c ****       *pDst++ = *pData++;
 433:Core/SystemView/SEGGER_RTT.c ****     };
 434:Core/SystemView/SEGGER_RTT.c ****     pDst = pRing->pBuffer;
 435:Core/SystemView/SEGGER_RTT.c ****     NumBytesAtOnce = NumBytes - Rem;
 436:Core/SystemView/SEGGER_RTT.c ****     while (NumBytesAtOnce--) {
 437:Core/SystemView/SEGGER_RTT.c ****       *pDst++ = *pData++;
 438:Core/SystemView/SEGGER_RTT.c ****     };
 439:Core/SystemView/SEGGER_RTT.c ****     pRing->WrOff = NumBytes - Rem;
 440:Core/SystemView/SEGGER_RTT.c **** #else
 441:Core/SystemView/SEGGER_RTT.c ****     NumBytesAtOnce = Rem;
 442:Core/SystemView/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY(pRing->pBuffer + WrOff, pData, NumBytesAtOnce);
 443:Core/SystemView/SEGGER_RTT.c ****     NumBytesAtOnce = NumBytes - Rem;
 444:Core/SystemView/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY(pRing->pBuffer, pData + Rem, NumBytesAtOnce);
 445:Core/SystemView/SEGGER_RTT.c ****     pRing->WrOff = NumBytesAtOnce;
 446:Core/SystemView/SEGGER_RTT.c **** #endif
 447:Core/SystemView/SEGGER_RTT.c ****   }
 448:Core/SystemView/SEGGER_RTT.c **** }
