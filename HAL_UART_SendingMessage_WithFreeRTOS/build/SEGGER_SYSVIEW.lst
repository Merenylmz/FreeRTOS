 179:Core/SystemView/SEGGER_SYSVIEW.c **** */
 180:Core/SystemView/SEGGER_SYSVIEW.c **** // Timestamps may be less than full 32-bits, in which case we need to zero
 181:Core/SystemView/SEGGER_SYSVIEW.c **** // the unused bits to properly handle overflows.
 182:Core/SystemView/SEGGER_SYSVIEW.c **** // Note that this is a quite common scenario, as a 32-bit time such as
 183:Core/SystemView/SEGGER_SYSVIEW.c **** // SysTick might be scaled down to reduce bandwith
 184:Core/SystemView/SEGGER_SYSVIEW.c **** // or a 16-bit hardware time might be used.
 185:Core/SystemView/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_TIMESTAMP_BITS < 32  // Eliminate unused bits in case hardware timestamps are le
 186:Core/SystemView/SEGGER_SYSVIEW.c ****   #define MAKE_DELTA_32BIT(Delta) Delta <<= 32 - SEGGER_SYSVIEW_TIMESTAMP_BITS; \
 187:Core/SystemView/SEGGER_SYSVIEW.c ****                                   Delta >>= 32 - SEGGER_SYSVIEW_TIMESTAMP_BITS;
 188:Core/SystemView/SEGGER_SYSVIEW.c **** #else
 189:Core/SystemView/SEGGER_SYSVIEW.c ****   #define MAKE_DELTA_32BIT(Delta)
 190:Core/SystemView/SEGGER_SYSVIEW.c **** #endif
 191:Core/SystemView/SEGGER_SYSVIEW.c **** 
 192:Core/SystemView/SEGGER_SYSVIEW.c **** 
