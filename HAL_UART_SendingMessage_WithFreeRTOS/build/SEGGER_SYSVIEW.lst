2353:Core/SystemView/SEGGER_SYSVIEW.c **** *
2354:Core/SystemView/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_RegisterModule()
2355:Core/SystemView/SEGGER_SYSVIEW.c **** *
2356:Core/SystemView/SEGGER_SYSVIEW.c **** *  Function description
2357:Core/SystemView/SEGGER_SYSVIEW.c **** *    Register a middleware module for recording its events.
2358:Core/SystemView/SEGGER_SYSVIEW.c **** *
2359:Core/SystemView/SEGGER_SYSVIEW.c **** *  Parameters
2360:Core/SystemView/SEGGER_SYSVIEW.c **** *    pModule  - The middleware module information.
2361:Core/SystemView/SEGGER_SYSVIEW.c **** *
2362:Core/SystemView/SEGGER_SYSVIEW.c **** *  Additional information
2363:Core/SystemView/SEGGER_SYSVIEW.c **** *    SEGGER_SYSVIEW_MODULE elements:
2364:Core/SystemView/SEGGER_SYSVIEW.c **** *      sDescription      - Pointer to a string containing the module name and optionally the module
2365:Core/SystemView/SEGGER_SYSVIEW.c **** *      NumEvents         - Number of events the module wants to register.
2366:Core/SystemView/SEGGER_SYSVIEW.c **** *      EventOffset       - Offset to be added to the event Ids. Out parameter, set by this function
2367:Core/SystemView/SEGGER_SYSVIEW.c **** *      pfSendModuleDesc  - Callback function pointer to send more detailed module description to Sy
2368:Core/SystemView/SEGGER_SYSVIEW.c **** *      pNext             - Pointer to next registered module. Out parameter, set by this function. 
2369:Core/SystemView/SEGGER_SYSVIEW.c **** */
2370:Core/SystemView/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_RegisterModule(SEGGER_SYSVIEW_MODULE* pModule) {
2371:Core/SystemView/SEGGER_SYSVIEW.c ****   SEGGER_SYSVIEW_LOCK();
2372:Core/SystemView/SEGGER_SYSVIEW.c ****   if (_pFirstModule == 0) {
2373:Core/SystemView/SEGGER_SYSVIEW.c ****     //
2374:Core/SystemView/SEGGER_SYSVIEW.c ****     // No module registered, yet.
2375:Core/SystemView/SEGGER_SYSVIEW.c ****     // Start list with new module.
2376:Core/SystemView/SEGGER_SYSVIEW.c ****     // EventOffset is the base offset for modules
2377:Core/SystemView/SEGGER_SYSVIEW.c ****     //
2378:Core/SystemView/SEGGER_SYSVIEW.c ****     pModule->EventOffset = MODULE_EVENT_OFFSET;
2379:Core/SystemView/SEGGER_SYSVIEW.c ****     pModule->pNext = 0;
2380:Core/SystemView/SEGGER_SYSVIEW.c ****     _pFirstModule = pModule;
2381:Core/SystemView/SEGGER_SYSVIEW.c ****     _NumModules = 1;
2382:Core/SystemView/SEGGER_SYSVIEW.c ****   } else {
2383:Core/SystemView/SEGGER_SYSVIEW.c ****     //
2384:Core/SystemView/SEGGER_SYSVIEW.c ****     // Registreded module(s) present.
ARM GAS  /tmp/ccJtfFJQ.s 			page 56


2385:Core/SystemView/SEGGER_SYSVIEW.c ****     // Prepend new module in list.
2386:Core/SystemView/SEGGER_SYSVIEW.c ****     // EventOffset set from number of events and offset of previous module.
2387:Core/SystemView/SEGGER_SYSVIEW.c ****     //
2388:Core/SystemView/SEGGER_SYSVIEW.c ****     pModule->EventOffset = _pFirstModule->EventOffset + _pFirstModule->NumEvents;
2389:Core/SystemView/SEGGER_SYSVIEW.c ****     pModule->pNext = _pFirstModule;
2390:Core/SystemView/SEGGER_SYSVIEW.c ****     _pFirstModule = pModule;
2391:Core/SystemView/SEGGER_SYSVIEW.c ****     _NumModules++;
2392:Core/SystemView/SEGGER_SYSVIEW.c ****   }
2393:Core/SystemView/SEGGER_SYSVIEW.c ****   SEGGER_SYSVIEW_SendModule(0);
2394:Core/SystemView/SEGGER_SYSVIEW.c ****   if (pModule->pfSendModuleDesc) {
2395:Core/SystemView/SEGGER_SYSVIEW.c ****     pModule->pfSendModuleDesc();
2396:Core/SystemView/SEGGER_SYSVIEW.c ****   }
2397:Core/SystemView/SEGGER_SYSVIEW.c ****   SEGGER_SYSVIEW_UNLOCK();
2398:Core/SystemView/SEGGER_SYSVIEW.c **** }
