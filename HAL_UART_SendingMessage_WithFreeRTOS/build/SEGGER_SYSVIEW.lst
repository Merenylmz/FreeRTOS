  59:Core/SystemView/SEGGER_SYSVIEW.c **** 
  60:Core/SystemView/SEGGER_SYSVIEW.c **** File    : SEGGER_SYSVIEW.c
  61:Core/SystemView/SEGGER_SYSVIEW.c **** Purpose : System visualization API implementation.
  62:Core/SystemView/SEGGER_SYSVIEW.c **** Revision: $Rev: 12706 $
  63:Core/SystemView/SEGGER_SYSVIEW.c **** 
  64:Core/SystemView/SEGGER_SYSVIEW.c **** Additional information:
  65:Core/SystemView/SEGGER_SYSVIEW.c ****   Packet format:
  66:Core/SystemView/SEGGER_SYSVIEW.c ****     Packets with IDs 0..23 are standard packets with known structure.
  67:Core/SystemView/SEGGER_SYSVIEW.c ****     For efficiency, they do *NOT* contain a length field.
  68:Core/SystemView/SEGGER_SYSVIEW.c ****     <ID><Data><TimeStampDelta>
  69:Core/SystemView/SEGGER_SYSVIEW.c **** 
  70:Core/SystemView/SEGGER_SYSVIEW.c ****     Packets with IDs 24..31 are standard packets with extendible
  71:Core/SystemView/SEGGER_SYSVIEW.c ****     structure and contain a length field.
  72:Core/SystemView/SEGGER_SYSVIEW.c ****     <ID><Lenght><Data><TimeStampDelta>
  73:Core/SystemView/SEGGER_SYSVIEW.c **** 
  74:Core/SystemView/SEGGER_SYSVIEW.c ****     Packets with IDs >= 32 always contain a length field.
  75:Core/SystemView/SEGGER_SYSVIEW.c ****     <ID><Length><Data><TimeStampDelta>
  76:Core/SystemView/SEGGER_SYSVIEW.c **** 
  77:Core/SystemView/SEGGER_SYSVIEW.c ****   Packet IDs:
  78:Core/SystemView/SEGGER_SYSVIEW.c ****        0..  31 : Standard packets, known by SystemViewer.
  79:Core/SystemView/SEGGER_SYSVIEW.c ****       32..1023 : OS-definable packets, described in a SystemView description file.
  80:Core/SystemView/SEGGER_SYSVIEW.c ****     1024..2047 : User-definable packets, described in a SystemView description file.
  81:Core/SystemView/SEGGER_SYSVIEW.c ****     2048..32767: Undefined.
  82:Core/SystemView/SEGGER_SYSVIEW.c **** 
  83:Core/SystemView/SEGGER_SYSVIEW.c ****   Data encoding:
  84:Core/SystemView/SEGGER_SYSVIEW.c ****     Basic types (int, short, char, ...):
  85:Core/SystemView/SEGGER_SYSVIEW.c ****       Basic types are encoded little endian with most-significant bit variant
  86:Core/SystemView/SEGGER_SYSVIEW.c ****       encoding.
  87:Core/SystemView/SEGGER_SYSVIEW.c ****       Each encoded byte contains 7 data bits [6:0] and the MSB continuation bit.
ARM GAS  /tmp/ccJtfFJQ.s 			page 3


  88:Core/SystemView/SEGGER_SYSVIEW.c ****       The continuation bit indicates whether the next byte belongs to the data
  89:Core/SystemView/SEGGER_SYSVIEW.c ****       (bit set) or this is the last byte (bit clear).
  90:Core/SystemView/SEGGER_SYSVIEW.c ****       The most significant bits of data are encoded first, proceeding to the
  91:Core/SystemView/SEGGER_SYSVIEW.c ****       least significant bits in the final byte (little endian).
  92:Core/SystemView/SEGGER_SYSVIEW.c **** 
  93:Core/SystemView/SEGGER_SYSVIEW.c ****       Example encoding:
  94:Core/SystemView/SEGGER_SYSVIEW.c ****         Data: 0x1F4 (500)
  95:Core/SystemView/SEGGER_SYSVIEW.c ****         Encoded: 0xF4 (First 7 data bits 74 | Continuation bit)
  96:Core/SystemView/SEGGER_SYSVIEW.c ****                  0x03 (Second 7 data bits 03, no continuation)
  97:Core/SystemView/SEGGER_SYSVIEW.c **** 
  98:Core/SystemView/SEGGER_SYSVIEW.c ****         Data: 0xFFFFFFFF
  99:Core/SystemView/SEGGER_SYSVIEW.c ****         Encoded: 0xFF 0xFF 0xFF 0xFF 0x0F
 100:Core/SystemView/SEGGER_SYSVIEW.c **** 
 101:Core/SystemView/SEGGER_SYSVIEW.c ****         Data: 0xA2 (162),   0x03 (3), 0x7000
 102:Core/SystemView/SEGGER_SYSVIEW.c ****         Encoded: 0xA2 0x01  0x03      0x80 0xE0 0x01
 103:Core/SystemView/SEGGER_SYSVIEW.c **** 
 104:Core/SystemView/SEGGER_SYSVIEW.c ****     Byte arrays and strings:
 105:Core/SystemView/SEGGER_SYSVIEW.c ****       Byte arrays and strings are encoded as <NumBytes> followed by the raw data.
 106:Core/SystemView/SEGGER_SYSVIEW.c ****       NumBytes is encoded as a basic type with a theoretical maximum of 4G.
 107:Core/SystemView/SEGGER_SYSVIEW.c **** 
 108:Core/SystemView/SEGGER_SYSVIEW.c ****       Example encoding:
 109:Core/SystemView/SEGGER_SYSVIEW.c ****         Data: "Hello World\0" (0x48 0x65 0x6C 0x6C 0x6F 0x20 0x57 0x6F 0x72 0x6C 0x64 0x00)
 110:Core/SystemView/SEGGER_SYSVIEW.c ****         Encoded: 0x0B 0x48 0x65 0x6C 0x6C 0x6F 0x20 0x57 0x6F 0x72 0x6C 0x64
 111:Core/SystemView/SEGGER_SYSVIEW.c **** 
 112:Core/SystemView/SEGGER_SYSVIEW.c ****   Examples packets:
 113:Core/SystemView/SEGGER_SYSVIEW.c ****   01 F4 03 80 80 10 // Overflow packet. Data is a single U32.
 114:Core/SystemView/SEGGER_SYSVIEW.c ****                        This packet means: 500 packets lost, Timestamp is 0x40000
 115:Core/SystemView/SEGGER_SYSVIEW.c **** 
 116:Core/SystemView/SEGGER_SYSVIEW.c ****   02 0F 50          // ISR(15) Enter. Timestamp 80 (0x50)
 117:Core/SystemView/SEGGER_SYSVIEW.c **** 
 118:Core/SystemView/SEGGER_SYSVIEW.c ****   03 20             // ISR Exit. Timestamp 32 (0x20) (Shortest possible packet.)
 119:Core/SystemView/SEGGER_SYSVIEW.c **** 
 120:Core/SystemView/SEGGER_SYSVIEW.c ****   Sample code for user defined Packets:
 121:Core/SystemView/SEGGER_SYSVIEW.c ****     #define MY_ID   0x400                // Any value between 0x400 and 0x7FF
 122:Core/SystemView/SEGGER_SYSVIEW.c ****     void SendMyPacket(unsigned Para0, unsigned Para1, const char* s) {
 123:Core/SystemView/SEGGER_SYSVIEW.c ****       U8  aPacket[SEGGER_SYSVIEW_INFO_SIZE + 2 * SEGGER_SYSVIEW_QUANTA_U32 + MAX_STR_LEN + 1];
 124:Core/SystemView/SEGGER_SYSVIEW.c ****       U8* pPayload;
 125:Core/SystemView/SEGGER_SYSVIEW.c ****       //
 126:Core/SystemView/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_PPREPARE_PACKET(aPacket);               // Prepare the packet for S
 127:Core/SystemView/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_EncodeU32(pPayload, Para0);             // Add the first parameter 
 128:Core/SystemView/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_EncodeU32(pPayload, Para1);             // Add the second parameter
 129:Core/SystemView/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_EncodeString(pPayload, s, MAX_STR_LEN); // Add the string to the pa
 130:Core/SystemView/SEGGER_SYSVIEW.c ****       //
 131:Core/SystemView/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_SendPacket(&aPacket[0], pPayload, MY_ID);          // Send the packet with Eve
 132:Core/SystemView/SEGGER_SYSVIEW.c ****     }
 133:Core/SystemView/SEGGER_SYSVIEW.c **** 
 134:Core/SystemView/SEGGER_SYSVIEW.c ****     #define MY_ID_1 0x401
 135:Core/SystemView/SEGGER_SYSVIEW.c ****     void SendOnePara(unsigned Para0) {
 136:Core/SystemView/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_RecordU32(MY_ID_1, Para0);
 137:Core/SystemView/SEGGER_SYSVIEW.c ****     }
 138:Core/SystemView/SEGGER_SYSVIEW.c **** 
 139:Core/SystemView/SEGGER_SYSVIEW.c **** */
 140:Core/SystemView/SEGGER_SYSVIEW.c **** 
