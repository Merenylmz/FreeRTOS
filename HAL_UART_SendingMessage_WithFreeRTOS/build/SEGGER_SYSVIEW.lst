1628:Core/SystemView/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_RecordString(unsigned int EventID, const char* pString) {
1629:Core/SystemView/SEGGER_SYSVIEW.c ****   U8* pPayload;
