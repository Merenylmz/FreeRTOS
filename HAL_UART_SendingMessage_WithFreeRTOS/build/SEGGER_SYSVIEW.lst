1639:Core/SystemView/SEGGER_SYSVIEW.c **** *
1640:Core/SystemView/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_Start()
1641:Core/SystemView/SEGGER_SYSVIEW.c **** *
1642:Core/SystemView/SEGGER_SYSVIEW.c **** *  Function description
1643:Core/SystemView/SEGGER_SYSVIEW.c **** *    Start recording SystemView events.
1644:Core/SystemView/SEGGER_SYSVIEW.c **** *    This function is triggered by the host application.
1645:Core/SystemView/SEGGER_SYSVIEW.c **** *
1646:Core/SystemView/SEGGER_SYSVIEW.c **** *  Additional information
1647:Core/SystemView/SEGGER_SYSVIEW.c **** *    This function enables transmission of SystemView packets recorded
1648:Core/SystemView/SEGGER_SYSVIEW.c **** *    by subsequent trace calls and records a SystemView Start event.
1649:Core/SystemView/SEGGER_SYSVIEW.c **** *
1650:Core/SystemView/SEGGER_SYSVIEW.c **** *    As part of start, a SystemView Init packet is sent, containing the system
1651:Core/SystemView/SEGGER_SYSVIEW.c **** *    frequency. The list of current tasks, the current system time and the
1652:Core/SystemView/SEGGER_SYSVIEW.c **** *    system description string is sent, too.
ARM GAS  /tmp/ccJtfFJQ.s 			page 39


1653:Core/SystemView/SEGGER_SYSVIEW.c **** *
1654:Core/SystemView/SEGGER_SYSVIEW.c **** *  Notes
1655:Core/SystemView/SEGGER_SYSVIEW.c **** *    SEGGER_SYSVIEW_Start and SEGGER_SYSVIEW_Stop do not nest.
1656:Core/SystemView/SEGGER_SYSVIEW.c **** */
1657:Core/SystemView/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_Start(void) {
1658:Core/SystemView/SEGGER_SYSVIEW.c ****   if (_SYSVIEW_Globals.EnableState == 0) {
1659:Core/SystemView/SEGGER_SYSVIEW.c ****     _SYSVIEW_Globals.EnableState = 1;
1660:Core/SystemView/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_POST_MORTEM_MODE == 1)
1661:Core/SystemView/SEGGER_SYSVIEW.c ****     _SendSyncInfo();
1662:Core/SystemView/SEGGER_SYSVIEW.c **** #else
1663:Core/SystemView/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_LOCK();
1664:Core/SystemView/SEGGER_SYSVIEW.c ****     SEGGER_RTT_WriteSkipNoLock(CHANNEL_ID_UP, _abSync, 10);
1665:Core/SystemView/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_UNLOCK();
1666:Core/SystemView/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_RecordVoid(SYSVIEW_EVTID_TRACE_START);
1667:Core/SystemView/SEGGER_SYSVIEW.c ****     {
1668:Core/SystemView/SEGGER_SYSVIEW.c ****       U8* pPayload;
1669:Core/SystemView/SEGGER_SYSVIEW.c ****       U8* pPayloadStart;
1670:Core/SystemView/SEGGER_SYSVIEW.c ****       RECORD_START(SEGGER_SYSVIEW_INFO_SIZE + 4 * SEGGER_SYSVIEW_QUANTA_U32);
1671:Core/SystemView/SEGGER_SYSVIEW.c ****       //
1672:Core/SystemView/SEGGER_SYSVIEW.c ****       pPayload = pPayloadStart;
1673:Core/SystemView/SEGGER_SYSVIEW.c ****       ENCODE_U32(pPayload, _SYSVIEW_Globals.SysFreq);
1674:Core/SystemView/SEGGER_SYSVIEW.c ****       ENCODE_U32(pPayload, _SYSVIEW_Globals.CPUFreq);
1675:Core/SystemView/SEGGER_SYSVIEW.c ****       ENCODE_U32(pPayload, _SYSVIEW_Globals.RAMBaseAddress);
1676:Core/SystemView/SEGGER_SYSVIEW.c ****       ENCODE_U32(pPayload, SEGGER_SYSVIEW_ID_SHIFT);
1677:Core/SystemView/SEGGER_SYSVIEW.c ****       _SendPacket(pPayloadStart, pPayload, SYSVIEW_EVTID_INIT);
1678:Core/SystemView/SEGGER_SYSVIEW.c ****       RECORD_END();
1679:Core/SystemView/SEGGER_SYSVIEW.c ****     }
1680:Core/SystemView/SEGGER_SYSVIEW.c ****     if (_SYSVIEW_Globals.pfSendSysDesc) {
1681:Core/SystemView/SEGGER_SYSVIEW.c ****       _SYSVIEW_Globals.pfSendSysDesc();
1682:Core/SystemView/SEGGER_SYSVIEW.c ****     }
1683:Core/SystemView/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_RecordSystime();
1684:Core/SystemView/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_SendTaskList();
1685:Core/SystemView/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_SendNumModules();
1686:Core/SystemView/SEGGER_SYSVIEW.c **** #endif
1687:Core/SystemView/SEGGER_SYSVIEW.c ****   }
