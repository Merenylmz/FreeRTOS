{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mikrocontroller Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/HAL_UART_SendingMessage_WithFreeRTOS.elf",
            "request": "launch",
            "type": "cortex-debug",
